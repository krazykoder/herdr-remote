#!/usr/bin/env python3
"""Fake herdr. Reports different panes per HERDR_FAKE_HOST; logs writes to $FAKE_LOG."""
import json, os, sys

host = os.environ.get("HERDR_FAKE_HOST", "local")
log = os.environ.get("FAKE_LOG", "/tmp/fake_herdr.log")
args = sys.argv[1:]

PANES = {
    "local": [
        {"pane_id": "w1:p1", "agent": "claude", "label": "Architect 1", "agent_status": "idle",
         "cwd": "/work/charts/relay", "workspace_id": "w1", "tab_id": "w1:t1"},
        {"pane_id": "w8:p1", "agent": "codex", "label": "scratch", "agent_status": "working",
         "cwd": "/tmp", "workspace_id": "w8", "tab_id": "w8:t1"},
    ],
    "box": [
        {"pane_id": "w8:p1", "agent": "claude", "label": "Reviewer 1", "agent_status": "idle",
         "cwd": "/srv/relay", "workspace_id": "w8", "tab_id": "w8:t1"},
        {"pane_id": "w2:p1", "agent": "pi", "label": "pi", "agent_status": "working",
         "cwd": "/srv/relay/web", "workspace_id": "w2", "tab_id": "w2:t1"},
    ],
}

with open(log, "a") as f:
    f.write(f"{host} {' '.join(args)}\n")

# Agent names are a separate namespace from pane labels and `pane list` does not report them,
# so the fake keeps its own. FAKE_TAKEN_NAMES seeds it.
TAKEN = [n for n in os.environ.get("FAKE_TAKEN_NAMES", "").split(",") if n]

# FAKE_FAIL names a subcommand pair that should fail, e.g. "agent start".
fail = os.environ.get("FAKE_FAIL", "")
if fail and " ".join(args[:2]) == fail:
    if os.environ.get("FAKE_FAIL_MODE") == "no_id":
        print(json.dumps({"result": {}}))
        sys.exit(0)
    if os.environ.get("FAKE_FAIL_MODE") == "error_json":
        print(json.dumps({"error": {"code": "agent_name_taken", "message": "agent name is already used"}}))
        sys.exit(1)
    print("boom", file=sys.stderr)
    sys.exit(2)

if args[:2] == ["agent", "list"]:
    print(json.dumps({"result": {"agents": [{"name": n, "pane_id": f"{host}:p{i}"}
                                            for i, n in enumerate(TAKEN)]}}))
elif args[:2] == ["pane", "list"]:
    print(json.dumps({"result": {"panes": PANES.get(host, [])}}))
elif args[:2] == ["pane", "read"]:
    # Plain text, not JSON — herdr's read is the one command that is not a JSON envelope.
    # Hard-wrapped rows at a known width, so pane_cols has a wrap column to measure.
    print("\n".join(["x" * 87] * 3 + ["done."]))
elif args[:2] == ["workspace", "create"]:
    # A new workspace and a new tab each come up holding one shell pane, and that pane is the
    # one the relay hands to `agent start` — the agent takes it over rather than splitting it.
    print(json.dumps({"result": {"workspace": {"workspace_id": f"{host}:wNew"},
                                 "root_pane": {"pane_id": f"{host}:pShell"}}}))
elif args[:2] == ["tab", "create"]:
    print(json.dumps({"result": {"tab": {"tab_id": f"{host}:tNew"},
                                 "root_pane": {"pane_id": f"{host}:pShell"}}}))
elif args[:2] == ["pane", "split"]:
    print(json.dumps({"result": {"pane": {"pane_id": f"{host}:pSplit"}}}))
elif args[:2] == ["agent", "start"]:
    print(json.dumps({"result": {"agent": {"pane_id": f"{host}:pNew"}}}))
else:
    print(json.dumps({"result": {}}))
