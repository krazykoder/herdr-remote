#!/usr/bin/env python3
"""Fake herdr. Reports different panes per HERDR_FAKE_HOST; logs writes to $FAKE_LOG."""
import json, os, sys

host = os.environ.get("HERDR_FAKE_HOST", "local")
log = os.environ.get("FAKE_LOG", "/tmp/fake_herdr.log")
args = sys.argv[1:]

PANES = {
    "local": [
        {"pane_id": "w1:p1", "agent": "claude", "label": "Architect 1", "agent_status": "idle",
         "cwd": "/work/charts/relay", "workspace_id": "w1", "tab_id": "w1:t1"},
        {"pane_id": "w8:p1", "agent": "codex", "label": "scratch", "agent_status": "working",
         "cwd": "/tmp", "workspace_id": "w8", "tab_id": "w8:t1"},
        # A harness the app ships no gutter profile for. In w1's existing workspace on purpose —
        # no new Space chip for another spec's count to trip over — but in a second tab, which
        # makes w1 the one Space with a tab strip to walk. Was `pi` until pi got a profile of its
        # own; the name only has to be one the app has never heard of.
        {"pane_id": "w1:p2", "agent": "amp", "label": "amp", "agent_status": "idle",
         "cwd": "/work/charts/web", "workspace_id": "w1", "tab_id": "w1:t2"},
        # Panes with no agent. They have always been in this payload and were dropped before any
        # client saw them; terminal mode is the filter changing, not the data. w9 on purpose —
        # no start test names that workspace, so no spacer here can be reclaimed by one.
        {"pane_id": "w9:p1", "label": "build watch",
         "cwd": "/work/charts/relay", "workspace_id": "w9", "tab_id": "w9:t1"},
        {"pane_id": "w9:p2", "label": "· spacer ·",
         "cwd": "/work/charts/relay", "workspace_id": "w9", "tab_id": "w9:t1"},
        {"pane_id": "w9:p3", "label": "",
         "cwd": "/work/charts", "workspace_id": "w9", "tab_id": "w9:t2"},
    ],
    "box": [
        {"pane_id": "w8:p1", "agent": "claude", "label": "Reviewer 1", "agent_status": "idle",
         "cwd": "/srv/relay", "workspace_id": "w8", "tab_id": "w8:t1"},
        {"pane_id": "w2:p1", "agent": "amp", "label": "amp", "agent_status": "working",
         "cwd": "/srv/relay/web", "workspace_id": "w2", "tab_id": "w2:t1"},
        # Same pane ID as the local shell above. Shell IDs are per-server counters exactly as
        # agent IDs are, and this is the collision the ambiguity guard has to catch on both.
        {"pane_id": "w9:p1", "label": "notes",
         "cwd": "/srv", "workspace_id": "w9", "tab_id": "w9:t1"},
    ],
}

with open(log, "a") as f:
    f.write(f"{host} {' '.join(args)}\n")

# A pane list that can change. Unset, this fake is the fixed board above and every existing E2E
# sees exactly what it always did. Set, `pane list` is read from the file on every call and the
# test drives status transitions by rewriting it — which is the only way to have a turn *end*,
# and a turn ending is the whole trigger arbitration runs on.
STATE = os.environ.get("FAKE_PANES", "")


def state():
    with open(STATE) as f:
        return json.load(f)


def write_state(panes):
    with open(STATE, "w") as f:
        json.dump(panes, f)


# Enter at a pane that is waiting moves it to working, which is what a real TUI does when it
# accepts a submit — and what submit_paste watches for. Without this the relay presses its four
# times, never sees the pane move, and reports every arbitrated send unconfirmed.
if STATE and args[:2] == ["pane", "send-keys"] and "Enter" in args[3:]:
    panes = state()
    for p in panes:
        if p.get("pane_id") == args[2] and p.get("agent_status") in ("idle", "done"):
            p["agent_status"] = "working"
    write_state(panes)
    print(json.dumps({"result": {}}))
    sys.exit(0)

if STATE and args[:2] == ["pane", "list"]:
    print(json.dumps({"result": {"panes": state()}}))
    sys.exit(0)

# Agent names are a separate namespace from pane labels and `pane list` does not report them,
# so the fake keeps its own. FAKE_TAKEN_NAMES seeds it.
TAKEN = [n for n in os.environ.get("FAKE_TAKEN_NAMES", "").split(",") if n]

# FAKE_FAIL names a subcommand pair that should fail, e.g. "agent start".
fail = os.environ.get("FAKE_FAIL", "")
if fail and " ".join(args[:2]) == fail:
    if os.environ.get("FAKE_FAIL_MODE") == "no_id":
        print(json.dumps({"result": {}}))
        sys.exit(0)
    if os.environ.get("FAKE_FAIL_MODE") == "error_json":
        print(json.dumps({"error": {"code": "agent_name_taken", "message": "agent name is already used"}}))
        sys.exit(1)
    print("boom", file=sys.stderr)
    sys.exit(2)

if args[:2] == ["agent", "list"]:
    print(json.dumps({"result": {"agents": [{"name": n, "pane_id": f"{host}:p{i}"}
                                            for i, n in enumerate(TAKEN)]}}))
elif args[:2] == ["pane", "list"]:
    print(json.dumps({"result": {"panes": PANES.get(host, [])}}))
elif args[:2] == ["pane", "read"]:
    # Plain text, not JSON — herdr's read is the one command that is not a JSON envelope.
    # Hard-wrapped rows at a known width, so pane_cols has a wrap column to measure.
    #
    # The pane's own id is in the text on purpose: with two views on screen, "did this reply land
    # in the right column" is only answerable if the two panes do not read identically. Padded to
    # the same 87 so it cannot become the widest line and move the measured wrap column.
    pane = args[2] if len(args) > 2 else "?"
    print("\n".join(["x" * 87] * 3 + [f"pane {pane}".ljust(87, "-"), "done."]))
elif args[:2] == ["workspace", "create"]:
    # A new workspace and a new tab each come up holding one shell pane, and that pane is the
    # one the relay hands to `agent start` — the agent takes it over rather than splitting it.
    print(json.dumps({"result": {"workspace": {"workspace_id": f"{host}:wNew"},
                                 "root_pane": {"pane_id": f"{host}:pShell"}}}))
elif args[:2] == ["tab", "create"]:
    print(json.dumps({"result": {"tab": {"tab_id": f"{host}:tNew"},
                                 "root_pane": {"pane_id": f"{host}:pShell"}}}))
elif args[:2] == ["pane", "split"]:
    print(json.dumps({"result": {"pane": {"pane_id": f"{host}:pSplit"}}}))
elif args[:2] == ["agent", "start"]:
    print(json.dumps({"result": {"agent": {"pane_id": f"{host}:pNew"}}}))
else:
    print(json.dumps({"result": {}}))
